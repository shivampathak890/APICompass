# ==============================================================================
# APICompass v3 — Environment Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   copy .env.example .env
#
# DO NOT COMMIT REAL SECRETS OR KEYS TO VERSION CONTROL.
# ==============================================================================

# Application Environment (development | testing | production)
APP_ENV=development

# Explicit Mock Mode (true = deterministic local mock fixtures; false = live external calls)
MOCK_MODE=true

# Backend Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_VERSION=0.1.0

# Frontend Allowed Origin (for strict CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Approved Documentation Domains for Ingestion (comma-separated HTTPS hosts)
APPROVED_DOC_HOSTS=stripe.com,docs.stripe.com,github.com

# ------------------------------------------------------------------------------
# Optional External Integration Credentials
# (Not required for offline development or mock mode operation)
# ------------------------------------------------------------------------------
TINYFISH_API_KEY=
TINYFISH_SEARCH_BASE_URL=https://api.search.tinyfish.ai
TINYFISH_FETCH_BASE_URL=https://api.fetch.tinyfish.ai
DOC_RETRIEVAL_TIMEOUT_SECONDS=15.0
DOC_MAX_RESULTS_LIMIT=10

# LLM-Assisted Candidate Reasoning
# Provider options: 'disabled' (default offline), 'mock' (offline deterministic simulation), 'openai'
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_CHARS=8000

# ------------------------------------------------------------------------------
# Network Resilience & Circuit Breaker
# ------------------------------------------------------------------------------
DOC_RETRIEVAL_MAX_RETRIES=2
DOC_RETRIEVAL_BASE_BACKOFF_SECONDS=0.05
DOC_CIRCUIT_BREAKER_FAILURES=3
DOC_CIRCUIT_BREAKER_RECOVERY_SECONDS=30.0

# ------------------------------------------------------------------------------
# SQLite Audit Database Configuration
# ------------------------------------------------------------------------------
APICOMPASS_DB_PATH=data/apicompass.db
DB_BUSY_TIMEOUT_MS=5000
# Privacy Guard: raw submitted source code retention is disabled by default.
# Only SHA-256 fingerprint and byte length are stored in audit records.
SOURCE_RETENTION_ENABLED=false

# ------------------------------------------------------------------------------
# Opt-In Live Provider Smoke Tests
# (Strictly disabled by default; set to 1 only when explicitly executing live smoke tests)
# ------------------------------------------------------------------------------
# APICOMPASS_LIVE_SMOKE_TESTS=0
# APICOMPASS_LIVE_PROVIDER=all
